            "executeJavaScript": "const session = context.get('session')\nconst LUMA_API = 'https://api.lumahealth.io/api';\nconst api = axios.create({\n    baseURL: LUMA_API,\n    headers: {\n      'X-Access-Token': session.token,\n    },\n  });\n\nfunction getPatientIdFromRawHl7(rawHl7) {\n  const content = rawHl7.content;\n\n  if (!content || !content.PID) {\n    log('no PID segment found in content');\n    return null;\n  }\n\n  const patientIdentifierList = content.PID[2];\n\n  if (!patientIdentifierList) {\n    log('no patient identifier found in PID segment');\n    return null;\n  }\n\n  const patientId = patientIdentifierList.split('^')[0];\n\n  log(`extracted patient ID: ${patientId}`);\n\n  return patientId;\n}\n\nasync function findPatient(patientExternalId) {\n  log(`searching for patient ${patientExternalId}`);\n\n  const response = await api.get(`/patients/search?value=id:${patientExternalId}`);\n  const data = response.data;\n\n  if (!data || !Array.isArray(data)) {\n    return null;\n  }\n\n  if (data.length === 1) {\n    return data[0];\n  }\n\n  log(`unexpectedly found ${data.length} patients`);\n  return null;\n}\n\nlet patientExternalId;\n\ntry {\n  const rawHl7 = context.get('modelObject');\n  patientExternalId = getPatientIdFromRawHl7(rawHl7);\n\n  const patient = await findPatient(patientExternalId);\n\n  if (patient) {\n    log('found patient; setting in context');\n\n    context.set('followupWorkflowInstanceMergeContext', {\n      patient: patient._id\n    });\n    \n    log(context)\n    const followupWorkflowInstance = context.hasGet('followupWorkflowInstance')\n    const instanceResponse = await api.put(`/v2/followupWorkflowInstances/${followupWorkflowInstance._id}`, {\n     patient: patient._id\n     });\n     \n     log(`instance update response:`, instanceResponse)\n  }\n} catch (err) {\n  log(`patient ${patientExternalId} not found`);\n  log(err);\n}\n\nreturn { patientId: patientExternalId };",
